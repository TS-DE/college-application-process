# 复制为 .env 后按需修改（不配置则使用下列默认值）

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=gaokao
DB_CHARSET=utf8mb4

# ---------- Ollama（本地问答主力 / 0.13.0 起为 Agent 执行模型） ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
# ---------- Agent（Function Calling）----------
AGENT_ENABLED=1
# 极速模式：1=走确定性融合链路（快）；0=启用 Agent 两轮工具推理（演示用）
AGENT_FAST_MODE=1
AGENT_MAX_STEPS=2
AGENT_TOOL_TIMEOUT=60
AGENT_PLAN_TOKENS=350
AGENT_ANSWER_TOKENS=300
AGENT_PLAN_TIMEOUT=60
AGENT_ANSWER_TIMEOUT=25
AGENT_TOTAL_TIMEOUT=90
# ---------- 云端心理师 ----------
COUNSELOR_TIMEOUT=60
COUNSELOR_MAX_HISTORY=20
AI_ENABLED=1
AI_MAX_WORKERS=3

# ---------- LLM / Embedding 线上通道（0.7.1） ----------
# 线上大模型的 API Key（也可以直接配 Windows 系统环境变量 Ali_API_KEY）
Ali_API_KEY=你的阿里云百炼 API Key
# 必须是工作空间专属域名；不能用通用 dashscope 域名，也不能用 dashscope SDK
ALI_BASE_URL=https://ws-66jxf85tc3oa6b98.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_LLM_MODEL=qwen3.7-flash
# 向量模型与大语言模型共用同一个 Key 和同一个 base_url
ALI_EMBED_MODEL=text-embedding-v3
ALI_EMBED_DIMENSION=128
ALI_TIMEOUT=30
# 思考模式：关闭后实测单词请求 9.7s → 2.6s
ALI_ENABLE_THINKING=0
# 少于 N 字的简短问句跳过检索前预处理（0 表示永不跳过）
QUERY_PREPROCESS_MIN_LEN=20

# ---------- 业务参数 ----------
DEFAULT_PROVINCE=河南
# 冲稳保位次缓冲：|院校最低位次 - 考生位次| <= 5000 视为“稳”
RANK_BUFFER=5000
# “冲”向下、“保”向上最多搜索 buffer * 8 的位次范围
RANK_SPAN_FACTOR=8
TIER_LIMIT=60

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*

# ---------- 后台鉴权（JWT） ----------
# 生产环境务必改成随机长字符串
JWT_SECRET=gaokao-dev-secret-change-me
# Token 有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720

# ---------- 知识图谱（0.9.0） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
# 图谱通道总开关：0 = 关闭，走纯向量链路
GRAPH_ENABLED=1
# 融合层 Token 配额（总预算 4000：图谱 60% / 向量 40%）
GRAPH_MAX_TOKENS=2400
VECTOR_MAX_TOKENS=1600
# 实体识别双路：LLM 抽取路 / 词典匹配路
GRAPH_LLM_EXTRACT_ENABLED=1
GRAPH_DICT_EXTRACT_ENABLED=1
# ---------- 0.9.1 三路融合（图谱 + MySQL + 向量） ----------
# MySQL 结构化查询总开关：0 = 关闭，只走「图谱 + 向量」两路
MYSQL_QUERY_ENABLED=1
# MySQL 单次查询最大返回行数
MYSQL_MAX_ROWS=5

# ---------- 0.10.0 OCR 预处理（扫描件 PDF） ----------
# ★ OCR 通道 base_url 与文本 LLM 的 ALI_BASE_URL **不是同一个域名**，用错会一直失败
OCR_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# OCR 通道与文本 / Embedding / VLM 共用 Ali_API_KEY，无需单独配置 OCR_API_KEY
OCR_ENABLED=1
OCR_MODEL=qwen-vl-ocr
OCR_SCANNED_THRESHOLD=50
OCR_TIMEOUT=60
OCR_MAX_PAGES=50
OCR_CONCURRENCY=4
# 单页识别失败的重试次数（默认 1 = 最多 2 次调用），禁止无限重试
OCR_PAGE_RETRY=1

# ---------- 0.10.0 多模态「以文搜图」 ----------
# 命中触发关键词才走图像检索，其余问题走三路融合
MULTIMODAL_ENABLED=1
MULTIMODAL_TRIGGER_KEYWORDS=图,图片,照片,截图,图表,课程表,培养方案,校园,环境,长什么样,课程体系,学分结构,流程图,课程
# 图像独立向量空间（与文本集合分开，编码器不同不能混放）
IMAGE_COLLECTION=gaokao_images
# 图像编码器：auto=Chinese-CLIP 可用则用、否则用图注方案；clip / caption 可强制指定
IMAGE_ENCODER=auto
# 多模态问答用的视觉语言模型（支持图文输入）
MULTIMODAL_VLM_MODEL=qwen3.7-flash
IMAGE_MAX_SIDE=1024
MULTIMODAL_MAX_IMAGES=30
MULTIMODAL_TOP_K=3
