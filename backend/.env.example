# 复制为 .env 后按需修改（不配置则使用下列默认值）

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=gaokao
DB_CHARSET=utf8mb4

# ---------- Ollama ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=45
AI_ENABLED=1
AI_MAX_WORKERS=3

# ---------- 业务参数 ----------
DEFAULT_PROVINCE=河南
# 冲稳保位次缓冲：|院校最低位次 - 考生位次| <= 5000 视为“稳”
RANK_BUFFER=5000
# “冲”向下、“保”向上最多搜索 buffer * 8 的位次范围
RANK_SPAN_FACTOR=8
TIER_LIMIT=60

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*

# ---------- 后台鉴权（JWT） ----------
# 生产环境务必改成随机长字符串
JWT_SECRET=gaokao-dev-secret-change-me
# Token 有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720
