# 复制为 .env 后按需修改（不配置则使用下列默认值）

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=gaokao
DB_CHARSET=utf8mb4

# ---------- Ollama（本地兜底） ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=45
AI_ENABLED=1
AI_MAX_WORKERS=3

# ---------- LLM / Embedding 线上通道（v2.5.1） ----------
# 线上大模型的 API Key（也可以直接配 Windows 系统环境变量 Ali_API_KEY）
Ali_API_KEY=你的阿里云百炼 API Key
# 必须是工作空间专属域名；不能用通用 dashscope 域名，也不能用 dashscope SDK
ALI_BASE_URL=https://ws-66jxf85tc3oa6b98.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_LLM_MODEL=qwen3.7-flash-2026-07-15
# 向量模型与大语言模型共用同一个 Key 和同一个 base_url
ALI_EMBED_MODEL=text-embedding-v3
ALI_EMBED_DIMENSION=128
ALI_TIMEOUT=30
# 思考模式：关闭后实测单词请求 9.7s → 2.6s
ALI_ENABLE_THINKING=0
# 少于 N 字的简短问句跳过检索前预处理（0 表示永不跳过）
QUERY_PREPROCESS_MIN_LEN=20

# ---------- 业务参数 ----------
DEFAULT_PROVINCE=河南
# 冲稳保位次缓冲：|院校最低位次 - 考生位次| <= 5000 视为“稳”
RANK_BUFFER=5000
# “冲”向下、“保”向上最多搜索 buffer * 8 的位次范围
RANK_SPAN_FACTOR=8
TIER_LIMIT=60

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*

# ---------- 后台鉴权（JWT） ----------
# 生产环境务必改成随机长字符串
JWT_SECRET=gaokao-dev-secret-change-me
# Token 有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720
