# ============================================================
# 高考志愿填报系统 · 容器版环境变量模板
# 用法：cp .env.docker.example .env.docker  然后按需修改
#
# ★ 容器内连接地址已按下表改写（与 .env.example 的本地开发值不同，勿改回）：
#     DB_HOST=mysql            （本机开发为 localhost）
#     HOST=0.0.0.0             （本机开发为 127.0.0.1，不改则容器外无法访问）
#     OLLAMA_URL=http://ollama:11434   （启用 ollama 服务时）
#     NEO4J_URI=bolt://neo4j:7687      （启用 neo4j 服务时）
#
# 未列出的配置项均使用代码内置默认值（backend/app/config.py），无需填写。
# ============================================================

# ---------- MySQL ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
# ★ 必填：留空时 docker compose 会直接报错提示（不会使用空密码启动）
# 培训环境若沿用统一账号密码（root/123456），可在此填写；联调通过后建议改强密码
DB_PASSWORD=
DB_NAME=gaokao
DB_CHARSET=utf8mb4

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# ---------- 后台鉴权（JWT）----------
# 联调/生产务必改为随机长字符串：openssl rand -hex 32
JWT_SECRET=gaokao-dev-secret-change-me
JWT_EXPIRE_MINUTES=720

# ---------- 云端 LLM / Embedding（核心链路，★ 必填） ----------
# 变量名必须是 Ali_API_KEY（大小写敏感）；留空则云端链路不可用
Ali_API_KEY=
# 必须是工作空间专属域名，不能用通用 dashscope 域名
ALI_BASE_URL=https://ws-66jxf85tc3oa6b98.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_LLM_MODEL=qwen3.7-flash
ALI_EMBED_MODEL=text-embedding-v3
ALI_EMBED_DIMENSION=128
ALI_TIMEOUT=30
ALI_ENABLE_THINKING=0

# ---------- OCR（★ base_url 与文本通道不同域名，用错会一直 404/401） ----------
OCR_ENABLED=1
OCR_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
OCR_MODEL=qwen-vl-ocr
OCR_TIMEOUT=60
OCR_MAX_PAGES=50
OCR_CONCURRENCY=4
OCR_PAGE_RETRY=1

# ---------- Ollama（可选；未启用 ollama 服务时保持默认即可） ----------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_EMBED_MODEL=nomic-embed-text
AGENT_ENABLED=1
AGENT_FAST_MODE=1
AGENT_MAX_STEPS=2
AGENT_TOOL_TIMEOUT=60
AGENT_PLAN_TOKENS=350
AGENT_ANSWER_TOKENS=300
AGENT_PLAN_TIMEOUT=60
AGENT_ANSWER_TIMEOUT=25
AGENT_TOTAL_TIMEOUT=90

# ---------- 云端心理师 ----------
COUNSELOR_TIMEOUT=60
COUNSELOR_MAX_HISTORY=20

# ---------- 人机协同志愿规划（HITL / LangGraph） ----------
PLAN_LLM_ENABLED=1
PLAN_LLM_ALWAYS=0
PLAN_LLM_TIMEOUT=20
PLAN_DRAFT_PER_TIER=8
PLAN_FINAL_PER_TIER=8
PLAN_MAX_REVIEW_ROUNDS=5
PLAN_CHECKPOINTER=sqlite
PLAN_CHECKPOINT_DB=data/plan_checkpoints.db

# ---------- 知识图谱（可选；启用 neo4j 服务后 NEO4J_URI 保持此值） ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
GRAPH_ENABLED=1
GRAPH_MAX_TOKENS=2400
VECTOR_MAX_TOKENS=1600
GRAPH_LLM_EXTRACT_ENABLED=1
GRAPH_DICT_EXTRACT_ENABLED=1
GRAPH_LLM_TIMEOUT=20

# ---------- MySQL 结构化查询 ----------
MYSQL_QUERY_ENABLED=1
MYSQL_MAX_ROWS=5

# ---------- 业务参数 ----------
DEFAULT_PROVINCE=河南
RANK_BUFFER=5000
RANK_SPAN_FACTOR=8
TIER_LIMIT=60
TIER_CANDIDATE_LIMIT=120
QUERY_PREPROCESS_MIN_LEN=20

# ---------- 认证与 AI 线程池隔离 ----------
AUTH_TIMEOUT_SECONDS=30
AI_ENABLED=1
AI_MAX_WORKERS=3
AI_THREADPOOL_SIZE=8
AI_QUEUE_WAIT_WARN_SECONDS=5
AI_MAX_INFLIGHT_FACTOR=2
AI_SLOT_MAX_HOLD_SECONDS=600

# ---------- 多轮对话上下文 ----------
CHAT_HISTORY_MAX_TURNS=4
CHAT_HISTORY_MAX_CHARS=600
CHAT_TOTAL_TIMEOUT=100

# ---------- 高级 RAG 策略（可保持默认） ----------
ADVANCED_RAG_ENABLED=1
ADVANCED_RAG_STRATEGY=auto
RERANK_ENABLED=1
MULTI_QUERY_ENABLED=1
QUERY_REWRITE_ENABLED=1
QUERY_EXPANSION_ENABLED=1
QUERY_DECOMPOSE_ENABLED=1
MULTI_RECALL_FUSION=rrf
MULTI_RECALL_TOPK_PER_CHANNEL=20
CORRECTIVE_MAX_RETRY=1

# ---------- 多模态「以文搜图」 ----------
MULTIMODAL_ENABLED=1
MULTIMODAL_TRIGGER_KEYWORDS=图,图片,照片,截图,图表,课程表,培养方案,校园,环境,长什么样,课程体系,学分结构,流程图,课程
IMAGE_COLLECTION=gaokao_images
IMAGE_ENCODER=auto
MULTIMODAL_VLM_MODEL=qwen3.7-flash
IMAGE_MAX_SIDE=1024
MULTIMODAL_MAX_IMAGES=30
MULTIMODAL_TOP_K=3

# ---------- RAG 评估（可保持默认） ----------
EVAL_ENABLED=1
EVAL_LLM_METRICS_ENABLED=0
EVAL_SIM_THRESHOLD=0.65
EVAL_TOP_K=5
EVAL_MAX_SAMPLES=50
AUTO_TUNE_ENABLED=1
PROMPT_VERSION=standard
